// Prisma schema for EventSphere

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  ORGANIZER
}

enum Format {
  ONLINE
  IN_PERSON
}

enum Status {
  DRAFT
  PUBLISHED
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(ORGANIZER)
  events       Event[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([email])
}

model Event {
  id              String   @id @default(uuid())
  title           String
  slug            String   @unique
  summary         String
  description     String   @db.Text
  imageUrl        String
  category        String
  technologies    String[]
  startDateTime   DateTime
  endDateTime     DateTime
  timezone        String   @default("UTC")
  venue           String?
  onlineUrl       String?
  format          Format   @default(ONLINE)
  targetAudience  String
  registrationUrl String
  status          Status   @default(DRAFT)
  organizerId     String
  organizer       User     @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([slug])
  @@index([status])
  @@index([category])
  @@index([format])
  @@index([startDateTime])
  @@index([organizerId])
}
