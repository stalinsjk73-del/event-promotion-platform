# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/eventsphere?schema=public"

# Authentication & Security Secrets (Placeholders only)
JWT_SECRET="replace-with-a-secure-random-secret-key-at-least-32-chars"
JWT_EXPIRES_IN="7d"
COOKIE_SECRET="replace-with-a-secure-cookie-signing-secret"
