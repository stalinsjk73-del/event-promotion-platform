# ========================================================
# EventSphere - Environment Configuration Example
# ========================================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Database Connection (PostgreSQL)
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/eventsphere?schema=public"

# Authentication & Security
JWT_SECRET="replace-with-a-very-long-and-secure-random-secret-key-32chars"
JWT_EXPIRES_IN="7d"
COOKIE_SECRET="another-secure-cookie-signature-secret-key"

# Frontend Configuration (client/.env)
VITE_API_URL="http://localhost:5000/api"
